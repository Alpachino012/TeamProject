# Copy this file to .env and add your own keys. Never commit .env.

# LLM used for answer synthesis (anthropic | openai | gemini)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash

# Key for the selected LLM_PROVIDER; only the matching one is read.
GOOGLE_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Web search (tavily | serper | duckduckgo); duckduckgo needs no key
WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
# SERPER_API_KEY=

# Application
LOG_LEVEL=INFO
CACHE_DIR=./.cache
CACHE_TTL_SECONDS=86400
DATABASE_PATH=./research.db
PER_SOURCE_TIMEOUT_SECONDS=20
SYNTHESIS_TIMEOUT_SECONDS=30
EXTERNAL_CALL_TIMEOUT_SECONDS=6
MAX_SOURCES_PER_QUERY=3
MAX_PARALLEL=3
MAX_QUESTION_CHARS=1000
RETRY_ATTEMPTS=3
RETRY_INITIAL_DELAY_SECONDS=0.5
RETRY_MAX_DELAY_SECONDS=4
RATE_LIMIT_CAPACITY=6
RATE_LIMIT_REFILL_PER_SECOND=2
